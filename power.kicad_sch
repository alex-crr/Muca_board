	(global_label "VBUS_SENSE" (shape output) (at 218.44 96.52 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f3de673c-a2b4-42ab-95c1-f1eb28e57170") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 218.44 96.52 0) (hide yes) (effects (font (size 1.27 1.27)))))
	(text "Power path\n- USB-C sink: 5.1k on CC1/CC2 (default USB power, up to 500 mA / 900 mA). USBLC6-2SC6 ESD on D+/D-.\n- USB VBUS and CAN bus +5 V are ORed by two LM66100 ideal diodes (CE tied low, reverse-current blocking). Max input 5.5 V.\n- AP2112K-3.3: 600 mA LDO, ~250 mV dropout at 600 mA. Budget: ESP32-S3 with radio off ~60 mA, FT5316 ~10 mA, LEDs ~10 mA.\n- +3.3VA feeds the FT5316 analog supplies (VDDA, VDD3) through FB1 to keep MCU switching noise out of the sensing front end.\n- VBUS_SENSE = VBUS x 15/25 (3.0 V at 5 V) on an ADC1 pin so firmware knows whether USB is present." (exclude_from_sim no) (at 43.18 127.0 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "516fede2-1adf-4eef-91dd-81c2c4a33203"))
